{
  "appId": "app.elevenex.desktop",
  "productName": "Elevenex Desktop",
  "asar": true,
  "asarUnpack": [
    "dist/backend/host.js",
    "dist/backend/process-tree.js",
    "dist/remote/askpass-helper.js"
  ],
  "directories": {
    "output": "release",
    "buildResources": "assets/icons"
  },
  "files": [
    "dist/**/*.js",
    "dist/backend-release.json",
    "renderer/**/*",
    "assets/icons/icon.png",
    "assets/icons/tray*.png",
    "package.json"
  ],
  "npmRebuild": false,
  "mac": {
    "icon": "assets/icons/icon.icns",
    "category": "public.app-category.developer-tools",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "icon": "assets/icons/icon.ico",
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "installerIcon": "assets/icons/icon.ico",
    "uninstallerIcon": "assets/icons/icon.ico",
    "installerHeaderIcon": "assets/icons/icon.ico"
  },
  "dmg": {
    "icon": "assets/icons/icon.icns"
  },
  "linux": {
    "icon": "assets/icons/png",
    "category": "Development",
    "target": [
      "AppImage",
      "deb"
    ]
  }
}
