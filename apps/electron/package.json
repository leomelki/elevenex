{
  "name": "elevenex",
  "version": "0.0.0",
  "publisher": "elevenex",
  "author": {
    "name": "leomelki",
    "email": "melkileo@gmail.com"
  },
  "homepage": "https://github.com/leomelki/elevenex",
  "license": "CC-BY-NC-4.0",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test \"test/**/*.test.cjs\"",
    "test:webrtc": "electron test/webrtc-integration.cjs",
    "test:rendezvous": "pnpm build:rendezvous && electron test/rendezvous-integration.cjs",
    "build:rendezvous": "esbuild link-rendezvous-entry.mjs --bundle --format=esm --platform=browser --minify --outfile=vendor/rendezvous.mjs",
    "start": "pnpm build:rendezvous && electron .",
    "start:debug": "pnpm build:rendezvous && ELECTRON_DEBUG_FRONTEND=1 electron .",
    "package": "pnpm build:rendezvous && electron-builder",
    "package:mac": "pnpm build:rendezvous && electron-builder --mac",
    "package:mac:dir": "pnpm build:rendezvous && electron-builder --mac dir",
    "package:linux": "pnpm build:rendezvous && electron-builder --linux",
    "package:linux:dir": "pnpm build:rendezvous && electron-builder --linux dir",
    "package:win": "pnpm build:rendezvous && electron-builder --win",
    "package:win:dir": "pnpm build:rendezvous && electron-builder --win dir"
  },
  "build": {
    "appId": "fr.leomelki.elevenex",
    "productName": "Elevenex",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "icon": "assets/macos-runtime-icon.png",
    "asarUnpack": [
      "vendor/**/*"
    ],
    "files": [
      "*.cjs",
      "vendor/**/*",
      "assets/**/*",
      {
        "from": "../frontend/dist/frontend/browser",
        "to": "frontend/dist/frontend/browser",
        "filter": [
          "**/*",
          "!**/.git",
          "!**/.git/**",
          "!**/.github",
          "!**/.github/**",
          "!**/.gitignore",
          "!**/.gitattributes",
          "!**/.gitmodules",
          "!**/.gitkeep",
          "!**/*.map"
        ]
      },
      {
        "from": "../../11x.png",
        "to": "11x.png"
      },
      "!**/.git",
      "!**/.git/**",
      "!**/.github",
      "!**/.github/**",
      "!**/.gitignore",
      "!**/.gitattributes",
      "!**/.gitmodules",
      "!**/.gitkeep"
    ],
    "extraResources": [
      {
        "from": ".stage/version",
        "to": "version"
      }
    ],
    "mac": {
      "icon": "assets/macos-runtime-icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Elevenex needs access to your Documents folder to read and watch your project files.",
        "NSDesktopFolderUsageDescription": "Elevenex needs access to your Desktop to read project files stored there.",
        "NSDownloadsFolderUsageDescription": "Elevenex needs access to your Downloads to read project files stored there.",
        "NSRemovableVolumesUsageDescription": "Elevenex needs access to project files on removable volumes.",
        "NSNetworkVolumesUsageDescription": "Elevenex needs access to project files on network volumes.",
        "NSAppleEventsUsageDescription": "Elevenex uses Apple Events to integrate with your shell and external tools.",
        "NSMicrophoneUsageDescription": "Elevenex uses your microphone to dictate prompts to coding agents."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist"
    },
    "linux": {
      "icon": "assets/macos-runtime-icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "sign": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@trystero-p2p/mqtt": "^0.25.4",
    "@trystero-p2p/torrent": "^0.25.4",
    "trystero": "^0.25.4"
  }
}
